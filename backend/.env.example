# ==============================================================================
# Novel-to-Movie AI Backend Configuration
# ==============================================================================
# Copy this file to `backend/.env` and fill in your values.
# NEVER commit your actual `.env` file containing live credentials to Git!

# ------------------------------------------------------------------------------
# 1. Gemini Multimodal API Key (FRD §8, PRD §16)
# ------------------------------------------------------------------------------
# Get your free/paid API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Provider Execution Mode
# ------------------------------------------------------------------------------
# Options:
# - "free_tier" : (Recommended $0 Budget) Uses free Gemini 3.8 Flash for reasoning,
#                 Gemini 3.8 Flash TTS for narration, and Ken-Burns animatics / manual
#                 video uploads for scenes with $0 budget.
# - "auto"      : Uses live API when GEMINI_API_KEY is present; falls back to mock.
# - "live"      : Full automated generation requiring paid Gemini + Veo API quotas.
# - "mock"      : 100% offline development mode without external API calls.
PROVIDER_MODE=free_tier

# ------------------------------------------------------------------------------
# 3. Model Configuration (Latest verified Oct 2026)
# ------------------------------------------------------------------------------
TEXT_MODEL=gemini-3.8-flash
TEXT_FAST_MODEL=gemini-3.5-flash-lite
IMAGE_MODEL=gemini-nano-banana-2.1
VIDEO_MODEL=veo-3.1-generate-preview
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
TEXT_TEMPERATURE=0.6

# ------------------------------------------------------------------------------
# 4. Video & Rendering Defaults
# ------------------------------------------------------------------------------
VIDEO_CLIP_SECONDS=8
VIDEO_RESOLUTION=720p
VIDEO_POLL_INTERVAL_SECONDS=10.0
VIDEO_TIMEOUT_SECONDS=900
USE_REFERENCE_IMAGES=true

# ------------------------------------------------------------------------------
# 5. Production & Budget Caps (FRD §8)
# ------------------------------------------------------------------------------
MAX_SCENES=8
MIN_SCENES=3
MAX_CLIPS_PER_PROJECT=12
MAX_BUDGET_USD=25.0
DEFAULT_BUDGET_USD=10.0
STORE_INTERACTIONS=false

# ------------------------------------------------------------------------------
# 6. Server & Storage Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/app.db
# APP_SECRET=your_secret_signing_key_here
